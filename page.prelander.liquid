  <script>
  (function() {
    var endTime = Date.now() + (11 * 3600 + 47 * 60 + 33) * 1000;

    function update() {
      var diff = Math.max(0, endTime - Date.now());
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);

      var hour = document.getElementById('cd-h');
      var min = document.getElementById('cd-m');
      var sec = document.getElementById('cd-s');

      if (hour && min && sec) {
        hour.textContent = String(h).padStart(2, '0');
        min.textContent = String(m).padStart(2, '0');
        sec.textContent = String(s).padStart(2, '0');
      }

      var mh = document.getElementById('mid-cd-h');
      var mm = document.getElementById('mid-cd-m');
      var ms = document.getElementById('mid-cd-s');

      if (mh && mm && ms) {
        mh.textContent = String(h).padStart(2, '0');
        mm.textContent = String(m).padStart(2, '0');
        ms.textContent = String(s).padStart(2, '0');
      }

      if (diff > 0) {
        setTimeout(update, 1000);
      }
    }

    update();
  })();

  function toggleFaq(btn) {
    var answer = btn.nextElementSibling;
    var isOpen = answer.classList.contains('open');

    document.querySelectorAll('.faq-answer').forEach(function(a) {
      a.classList.remove('open');
    });

    document.querySelectorAll('.faq-question').forEach(function(q) {
      q.classList.remove('open');
    });

    if (!isOpen) {
      answer.classList.add('open');
      btn.classList.add('open');
    }
  }
</script>

